{
  "name": "@frontal-labs/openapi",
  "version": "1.0.0",
  "description": "Unified OpenAPI specifications for Frontal services",
  "main": "index.js",
  "scripts": {
    "validate": "node scripts/validate.js",
    "validate:all": "node scripts/validate.js --all",
    "validate:service": "node scripts/validate.js --service",
    "generate": "npm run generate:public-sync",
    "generate:composite": "node scripts/generate-composite.js",
    "generate:public-sync": "node scripts/sync-public-from-frontal.js",
    "verify:public-sync": "node scripts/sync-public-from-frontal.js --verify-only",
    "lint": "eslint scripts/ --fix",
    "format": "prettier --write scripts/ *.md"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/openapi.git"
  },
  "keywords": [
    "openapi",
    "api",
    "specification",
    "frontal",
    "microservices",
    "documentation"
  ],
  "author": "Frontal Labs, Inc.",
  "license": "Apache-2.0",
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "js-yaml": "^4.1.0",
    "prettier": "^3.2.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "files": [
    "openapi/openapi.spec3.yaml",
    "openapi/openapi.spec3.json",
    "schemas/",
    "examples/",
    "README.md",
    "LICENSE.md"
  ]
}